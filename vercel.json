{
    "version": 2,
    "buildCommand": "npm run build",
    "devCommand": "npm run dev",
    "installCommand": "npm install",,
    					"value": ""
    "framework": "nextjs",
    "env": {
          "NEXT_PUBLIC_SUPABASE_URL": {
                  "description": "URL da API Supabase",
                  "required": true,
              					"value": ""
          },
          "NEXT_PUBLIC_SUPABASE_ANON_KEY": {
                  "description": "Chave anôn Supabase",
                  "required": true
          },
          "NEXT_PUBLIC_APP_URL": {
                  "description": "URL da aplicação",
                  "example": "https://nutricionista-meb.vercel.app",
              					"value": ""
          }
    },
    "headers": [
          {
                  "source": "/(.*)",
                  "headers": [
                            {
                                        "key": "Cache-Control",
                                        "value": "public, max-age=31536000, immutable"
                            },
                            {
                                        "key": "X-Content-Type-Options",
                                        "value": "nosniff"
                            },
                            {
                                        "key": "X-Frame-Options",
                                        "value": "DENY"
                            },
                            {
                                        "key": "X-XSS-Protection",
                                        "value": "1; mode=block"
                            },
                            {
                                        "key": "Referrer-Policy",
                                        "value": "strict-origin-when-cross-origin"
                            }
                  ]
          }
    ],
    "redirects": [
          {
                  "source": "/",
                  "destination": "/html/otimizado/___PAINEL_NUTRI.html",
                  "permanent": false
          },
          {
                  "source": "/painel",
                  "destination": "/html/otimizado/___PAINEL_NUTRI.html",
                  "permanent": false
          },
          {
                  "source": "/pacientes",
                  "destination": "/html/otimizado/_TELA_PACIENTE.html",
                  "permanent": false
          },
          {
                  "source": "/dashboard",
                  "destination": "/html/otimizado/_DASHBOARD_KPIS.html",
                  "permanent": false
          },
          {
                  "source": "/cardapio",
                  "destination": "/html/otimizado/__MODULO_CARDAPIO.html",
                  "permanent": false
          },
          {
                  "source": "/admin",
                  "destination": "/html/otimizado/_CONTROLE_CONSULTORIO.html",
                  "permanent": false
          }
    ],
    "regions": ["gru1"],
    "functions": {
          "api/**": {
                  "memory": 1024,
                  "maxDuration": 30
          }
    }
}
